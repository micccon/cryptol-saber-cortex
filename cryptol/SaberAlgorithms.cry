module SaberAlgorithms where
import SaberTypes
import SaberConstants
import Primitive::Keyless::Hash::SHA3::Instantiations::SHAKE128 as SHAKE128
import SaberHelpers

//===SHIFT FUNCTIONS========================================================
/**
 * Shift every coefficient of a polynomial left by `shift` bits.
 *
 * For fixed-width coefficient types (such as `Zq`), this corresponds to
 * multiplication by `2^shift` with wraparound in that coefficient domain.
 */
PolyShiftLeftN :
    {t}
    (fin t) =>
    Poly [t] -> [8] -> Poly [t]
PolyShiftLeftN poly shift = [ c << shift | c <- poly ]

/**
 * Shift every coefficient of a polynomial right by `shift` bits.
 *
 * For fixed-width coefficient types, this corresponds to dropping lower bits,
 * i.e. a power-of-two scaling down in bit representation.
 */
PolyShiftRightN :
    {t}
    (fin t) =>
    Poly [t] -> [8] -> Poly [t]
PolyShiftRightN poly shift = [ c >> shift | c <- poly ]

// Sanity check polynomial shift properties
// ========================================

// Check that shifting right, then left, by the same amount "zeroes out" the low-order bits
// NOTE: This property uses a magic "% 4" that is tied to the specific shift amount of 2.
//       If other shifts are to be tested, the magic "% 4" would need to be adjusted accordingly.
property check_shift_roundtrip (poly : Poly Zq) =
    and [ c % 4 == 0 | c <- PolyShiftLeftN (PolyShiftRightN poly 2) 2 ]

// Check the shifting right by the full width produces all zeroes
property check_shift_right_full (poly : Poly Zq) =
    PolyShiftRightN poly `eq == zero



//===BS<-->Poly CONVERSIONS=================================================
/**
 * Convert a byte string into a polynomial with `k`-bit coefficients.
 *
 * The bytes are flattened into bits and regrouped into 256 coefficients,
 * each of width `k`.
 */
BS2Poly:
    {k}
    (fin k, k >= 1)
    => ByteString (k * N / 8) -> Poly [k]
BS2Poly byteString = split`{each=k} (join byteString) // --- ORIGINALLY
// =====================================================
// Alternative implementation to, YOU GUESSED IT, match the reference implementation's BS<-->Poly conversion order!!!!
// I LOVE this game we're playing!!!
// BS2Poly byteString = split`{each=k} (join [ reverse b | b <- byteString ])

/**
 * Convert a polynomial with `k`-bit coefficients into a byte string.
 *
 * Coefficients are flattened into bits and then packed into bytes.
 */
Poly2BS:
    {k}
    (fin k, k >= 1)
    => Poly [k] -> ByteString (k * N / 8)
Poly2BS polynomial = split`{each=8} (join polynomial) // --- ORIGINALLY
// =====================================================
// Alternative implementation to, YOU GUESSED IT, match the reference implementation's BS<-->Poly conversion order!!!!
// I LOVE this game we're playing!!!
// Poly2BS polynomial = [ reverse b | b <- split`{each=8} (join polynomial) ]

// Sanity check BS<-->Poly conversion properties
// =============================================
/** 
 * If BS2Poly and Poly2BS are implemented correctly, then either function
 * should act as the "inverse" to the other. These properties prove that 
 * formally. 
 */
property check_Poly2BS_BS2Poly_Zq (p : Poly_Zq) =
    BS2Poly (Poly2BS p) == p
property check_BS2Poly_Poly2BS_Zq (bs : ByteString (eq * N / 8)) =
    Poly2BS ((BS2Poly bs) : Poly_Zq) == bs

property check_Poly2BS_BS2Poly_Zp (p : Poly_Zp) =
    BS2Poly (Poly2BS p) == p
property check_BS2Poly_Poly2BS_Zp (bs : ByteString (ep * N / 8)) =
    Poly2BS ((BS2Poly bs) : Poly_Zp) == bs



//===BS<-->PolyVec CONVERSIONS==============================================
/**
 * Convert a byte string into a vector of `l` polynomials with `k`-bit
 * coefficients.
 *
 * The input is split into `l` polynomial-sized slices, each decoded via
 * `BS2Poly`.
 */
BS2PolyVec:
    {k}
    (fin k, k >= 1)
    => ByteString (l * k * N / 8) -> PolyVec [k]
BS2PolyVec byteString = [ BS2Poly polyByteString | polyByteString <- (split`{parts=l} byteString) ]

/**
 * Convert a vector of `l` polynomials into a byte string.
 *
 * Each polynomial is encoded with `Poly2BS` and concatenated in order.
 */
PolyVec2BS:
    {k}
    (fin k, k >= 1)
    => PolyVec [k] -> ByteString (l * k * N / 8)
PolyVec2BS vector = join [ Poly2BS poly | poly <- vector ]

// Sanity check BS<-->PolyVec conversion properties
// ================================================
/** 
 * If BS2PolyVec and PolyVec2BS are implemented correctly, then either function
 * should act as the "inverse" to the other. These properties prove that 
 * formally. 
 */
property check_PolyVec2BS_BS2PolyVec_Zq (v : PolyVec_Zq) =
    BS2PolyVec (PolyVec2BS v) == v
property check_BS2PolyVec_PolyVec2BS_Zq (bs : ByteString (l * eq * N / 8)) =
    PolyVec2BS (BS2PolyVec`{eq} bs) == bs

property check_PolyVec2BS_BS2PolyVec_Zp (v : PolyVec_Zp) =
    BS2PolyVec (PolyVec2BS v) == v
property check_BS2PolyVec_PolyVec2BS_Zp (bs : ByteString (l * ep * N / 8)) =
    PolyVec2BS (BS2PolyVec`{ep} bs) == bs



//===PolyMul FUNCTION========================================================
/**
 * Compute negacyclic polynomial multiplication modulo `x^256 + 1`.
 *
 * This is the ring multiplication used for Saber polynomials, where terms
 * that wrap past degree 255 re-enter with a sign flip and are then combined
 * with other like terms.
 */
PolyMul :
    {k}
    (fin k, k >= 1)
    => Poly [k] -> Poly [k] -> Poly [k]
// PolyMul a b = 
// Old, naive implementation (was too slow for actual testing purposes and concrete evaluation)
//   [ sum [ contrib i c | i <- [0 .. 255] ] | c <- [0 .. 255] ]
//     where
//       contrib i c =
//         if i <= c
//         then (a @ i) * (b @ j)
//         else negate ((a @ i) * (b @ j))
//         where
//           j = (c - i) % 256
PolyMul a b = [ sum [ if i <= c
                      then (a @ i) * (b @ ((c - i) % 256))
                      else negate ((a @ i) * (b @ ((c - i) % 256)))
                    | i <- [0 .. 255] ]
            | c <- [0 .. 255] ]

// Sanity check negacyclic convolution properties
// ==============================================
property check_PolyMul_commutative (a : Poly Zq) (b : Poly Zq) =
    PolyMul a b == PolyMul b a
property check_PolyMul_identity (a : Poly Zq) =
    PolyMul a one == a
    where one = [1] # zero
property check_PolyMul_zero (a : Poly Zq) =
    PolyMul a zero == zero
property check_PolyMul_distributive (a : Poly Zq) (b : Poly Zq) (c : Poly Zq) =
    PolyMul a (zipWith (+) b c) == zipWith (+) (PolyMul a b) (PolyMul a c)



//===MatrixVectorMul FUNCTION================================================
/**
 * Multiply an `l x l` polynomial matrix by a length-`l` polynomial vector.
 *
 * Each output polynomial is the sum of `l` polynomial products along a row.
 */
MatrixVectorMul :
    {k}
    (fin k, k >= 1)
    => PolyMatrix [k] -> PolyVec [k] -> PolyVec [k]
MatrixVectorMul matrix vector =
    // Old, naive, schoolbook method
    // [ sum [ PolyMul (matrix @ i @ j) (vector @ j) | j <- [0 .. l-1] ] | i <- [0 .. l-1] ] 
    [ sum (zipWith PolyMul row vector) | row <- matrix ]

// Sanity check matrix-vector multiplication properties
// ====================================================
// Multiplying by the identity matrix should return the same vector
property check_MatrixVectorMul_identity (v : PolyVec_Zq) =
    MatrixVectorMul identityMatrix v == v
    where
        identityMatrix = [ [ if i == j then one else zero
                            | j <- [0 .. l-1] ]
                          | i <- [0 .. l-1] ]
        one = ([1] # zero) : Poly Zq
// Multiplying by zero matrix should give zero vector  
property check_MatrixVectorMul_zero (v : PolyVec_Zq) =
    MatrixVectorMul zero v == zero


//===InnerProd FUNCTION======================================================
/**
 * Compute the inner product of two polynomial vectors.
 *
 * The result is a single polynomial obtained by summing pairwise polynomial
 * products across the `l` vector positions.
 */
InnerProd :
    {k}
    (fin k, k >= 1)
    => PolyVec [k] -> PolyVec [k] -> Poly [k]
InnerProd va vb = [ sum [ PolyMul (va @ i) (vb @ i) @ k | i <- [0..l-1] ] | k <- [0..255] ]

// Sanity check inner-product properties
// =====================================
property check_InnerProd_commutative (va : PolyVec_Zp) (vb : PolyVec_Zp) =
    InnerProd va vb == InnerProd vb va
property check_InnerProd_zero (va : PolyVec_Zp) =
    InnerProd va zero == zero
property check_InnerProd_linear (va : PolyVec_Zp) (vb : PolyVec_Zp) (vc : PolyVec_Zp) =
    InnerProd va (zipWith (zipWith (+)) vb vc) ==
        zipWith (+) (InnerProd va vb) (InnerProd va vc)



/**
 * Generate the Saber public matrix over `Zq` from a seed using SHAKE-128.
 * The seed is expanded into enough bytes to fill all `l * l` polynomials,
 * then the output is reshaped in stages:
 *
 * 1. bytes -> `eq`-bit coefficients
 * 2. coefficients -> 256-coefficient polynomials
 * 3. polynomials -> `l x l` matrix
 */
GenMatrix_Zq : ByteString seedBytes -> PolyMatrix_Zq
GenMatrix_Zq seed = matrix
    where
        buf    : ByteString (l * l * N * eq / 8)
        buf    = SHAKE128::xofBytes`{dBytes = l * l * N * eq / 8} seed

        coeffs : [l * l * N] Zq
        coeffs = split`{each=eq} (join buf)

        polys  : [l * l] Poly_Zq
        polys  = split`{each=N} coeffs
        
        matrix : PolyMatrix_Zq
        matrix = split`{parts=l} polys

// Sanity check GenMatrix properties
// =================================
// Output should always be an l x l matrix of l-coefficient polynomials
property check_GenMatrix_dimensions (seed : ByteString 32) =
    length (GenMatrix_Zq seed) == `l /\
    and [ length row == `l | row <- GenMatrix_Zq seed ] /\
    and [ length poly == `N | row <- GenMatrix_Zq seed, poly <- row ]
// Different seeds should (almost always) produce different matrices
// NOTE: This should NOT be called with `:prove`, as this isn't a guaranteed property
//       Rather, `:check` should be run with a sufficiently set `:set tests` value (say, 100)
//       where all 100 (or, in extremely rare cases, nearly all 100) tests pass successfully.
property check_GenMatrix_distinct (seed1 : ByteString 32) (seed2 : ByteString 32) =
    seed1 != seed2 ==> GenMatrix_Zq seed1 != GenMatrix_Zq seed2



/**
 * Generate the Saber secret vector over `Zq` from a noise seed using
 * SHAKE-128.
 *
 * 1. The expanded output is split into `mu`-bit chunks
 * 2. Each chunk is split into two `mu/2` halves 
 * 3. Every coefficient is formed as the difference of Hamming weights of those halves (interpreted in `Zq`).
 */
GenSecret_Zq : ByteString noiseSeedBytes -> PolyVec_Zq
GenSecret_Zq seed = vector
    where
        buf : ByteString (l * N * mu / 8)
        buf = SHAKE128::xofBytes`{dBytes = l * N * mu / 8} seed

        pairs : [l * N] [2][mu / 2]
        pairs = map (split`{parts=2}) (split`{each=mu} (join buf))

        secretCoeffs : [l * N] Zq
        secretCoeffs = [ fromInteger (HammingWeight (k @ 0) - HammingWeight (k @ 1)) | k <- pairs ]

        vector : PolyVec_Zq
        vector = split`{parts=l} secretCoeffs

// Sanity check GenSecret properties
// =================================
// Coefficients should be bounded by mu/2 in absolute value
// i.e. when interpreted as integers they should be small
// NOTE: This, as with the GenMatrix property, should be run with `:check` instead of
//       `:prove`.
property check_GenSecret_bounded (seed : ByteString 32) =
    and [ c <= `(mu/2) \/ c >= `(2^^eq - mu/2)
        | row <- GenSecret_Zq seed
        , c   <- row ]