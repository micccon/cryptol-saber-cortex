module SaberHelpers where
import SaberTypes
import SaberConstants
import Primitive::Keyless::Hash::SHA3::Instantiations::SHAKE128 as SHAKE128

h1 : Poly Zq
h1 = ConstPoly (2 ^^ (`eq - `ep - 1))

h2 : Poly Zq
h2 = ConstPoly (2 ^^ (`ep - 2) - 2 ^^ (`ep - `et - 1) + 2 ^^ (`eq - `ep - 1))

h : PolyVec Zq
h = ConstPolyVec (2 ^^ (`eq - `ep - 1))

//===HAMMING WEIGHT=========================================================
/**
 * Compute the Hamming weight of a bit string by counting how many bits are set
 * to `True`. 
 *
 * The property below simply checks that the helper agrees with its defining
 * list-comprehension form on a concrete 256-bit input.
 */
HammingWeight:
    {n}
    (fin n, n >= 1)
    => BitString n -> Integer
HammingWeight bitString = sum [ if bit then 1 else 0 | bit <- bitString ]

// Sanity check Hamming Weight properties
// ======================================
// Zero input has weight zero
property check_HammingWeight_zero =
    HammingWeight (0 : BitString 8) == 0
// All-ones input has weight equal to the length
property check_HammingWeight_ones =
    HammingWeight (0xFF : BitString 8) == 8
// Weight is always non-negative
property check_HammingWeight_nonneg (bs : BitString 8) =
    HammingWeight bs >= 0
// Weight never exceeds the length
property check_HammingWeight_bounded (bs : BitString 8) =
    HammingWeight bs <= 8



//===RANDBYTES FUNCTION======================================================
/**
 * Produce a deterministic byte string for testing.
 *
 * The output length is `n` bytes (selected at the call site as a type
 * parameter), and bytes alternate as `6, 7, 6, 7, ...`.
 */
RandBytes:
    {n}
    (fin n, n >= 1)
    => Integer -> ByteString n
RandBytes n=
    [if num % 2 == 0 then 7 else 6 | num <- [1 .. n]]

property check_RandBytes =
    RandBytes 32 == [if num % 2 == 0 then 7 else 6 | num <- [1 .. 32]]



//===VerifyBS FUNCTION=======================================================
/**
 * Compare two byte strings for exact equality. This helper is intentionally
 * simple: it just exposes byte-string comparison through a named function so
 * it can be reused in the higher-level Saber code.
 */
VerifyBS :
    {n}
    (fin n, n >= 1)
    => ByteString n -> ByteString n -> Bit
VerifyBS bs1 bs2 = (bs1 == bs2)

// Trivial sanity check property
property check_VerifyBS (bs1 : ByteString 32) (bs2 : ByteString 32) =
    VerifyBS bs1 bs2 == (bs1 == bs2)



//===CONST POLY, VEC, MATRIX FUNCTIONS======================================
/**
 * Create polynomials, vectors of polynomials, and/or matrices of polynomials
 * where all coefficients are the same. Used in several contexts throughout the
 * SABER specification.
 */
ConstPoly :
    {k}
    k -> Poly k
ConstPoly elementVal = [ elementVal | _ <- [0 .. 255] ]

ConstPolyVec :
    {k}
    k -> PolyVec k
ConstPolyVec elementVal = [ ConstPoly elementVal | _ <- [0 .. l - 1] ]

ConstPolyMatrix :
    {k}
    k -> PolyMatrix k
ConstPolyMatrix elementVal = [ ConstPolyVec elementVal | _ <- [0 .. l - 1] ]



//===POLY ROUNDING FUNCTIONS================================================
/**
 * Round a polynomial from Zq to Zp by keeping the least significant ep bits.
 */
RoundPoly_ZqToZp : Poly Zq -> Poly Zp
RoundPoly_ZqToZp poly = [ drop`{eq - ep} coeff | coeff <- poly ]

RoundPolyVec_ZqToZp : PolyVec Zq -> PolyVec Zp
RoundPolyVec_ZqToZp vec = [ RoundPoly_ZqToZp p | p <- vec ]

/**
 * Lift a polynomial from Zt to Zp by zero-extending each coefficient.
 */
RoundPoly_ZtToZp : Poly Zt -> Poly Zp
RoundPoly_ZtToZp poly = [ zext coeff | coeff <- poly ]

RoundPolyVec_ZtToZp : PolyVec Zt -> PolyVec Zp
RoundPolyVec_ZtToZp vec = [ RoundPoly_ZtToZp p | p <- vec ]

/**
 * Round a polynomial from Zp to Zt keeping the least significant et bits.
 */
RoundPoly_ZpToZt : Poly Zp -> Poly Zt
RoundPoly_ZpToZt poly = [ drop`{ep - et} coeff | coeff <- poly ]

RoundPolyVec_ZpToZt : PolyVec Zp -> PolyVec Zt
RoundPolyVec_ZpToZt vec = [ RoundPoly_ZpToZt p | p <- vec ]

/**
 * Round a polynomial from Zp to Z2 by keeping only the least significant bit.
 */
RoundPoly_ZpToZ2 : Poly Zp -> Poly Z2
RoundPoly_ZpToZ2 poly = [ drop`{ep - 1} coeff | coeff <- poly ]

RoundPolyVec_ZpToZ2 : PolyVec Zp -> PolyVec Z2
RoundPolyVec_ZpToZ2 vec = [ RoundPoly_ZpToZ2 p | p <- vec ]

/**
 * Lift a polynomial from Z2 to Zp by zero-extending each coefficient.
 */
RoundPoly_Z2ToZp : Poly Z2 -> Poly Zp
RoundPoly_Z2ToZp poly = [ zext coeff | coeff <- poly ]

RoundPolyVec_Z2ToZp : PolyVec Z2 -> PolyVec Zp
RoundPolyVec_Z2ToZp vec = [ RoundPoly_Z2ToZp p | p <- vec ]