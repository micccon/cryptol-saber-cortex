module SaberKEM where
import SaberTypes
import SaberConstants
import SaberPKE
import SaberHelpers
import SaberAlgorithms
import Primitive::Keyless::Hash::SHA3::Instantiations::SHA3_256 as SHA3_256
import Primitive::Keyless::Hash::SHA3::Instantiations::SHA3_512 as SHA3_512

//===KEM KEYGEN=============================================================
/**
 * KEM KeyGen function where the seeds are provided, rather than produced
 * randomly as a part of the function. This is necessary for KAT testing
 * and evaluation.
 */
KEM_KeyGenDet :
    ByteString seedBytes ->
    ByteString noiseSeedBytes ->
    ByteString keyBytes ->
    (ByteString publicKeyBytes, ByteString secretKeyBytes)
KEM_KeyGenDet seedAInput seedS z = (publicKey, secretKey)
  where
    (pk, sk_cpa) = PKE_KeyGenDet seedAInput seedS

    pk_hash      : ByteString hashBytes
    pk_hash      = SHA3_256::hashBytes pk

    secretKey    : ByteString secretKeyBytes
    secretKey    = z # pk_hash # pk # sk_cpa

    publicKey    : ByteString publicKeyBytes
    publicKey    = pk

/**
 * KEM KeyGen function where the seeds are NOT provided. Rather, they are
 * "randomly" produced via our lovely RandBytes function (just a bunch of
 * continuous 676767's... lol. It's a funny number reference. Get it?)
 */
KEM_KeyGen : (ByteString publicKeyBytes, ByteString secretKeyBytes)
KEM_KeyGen = KEM_KeyGenDet (RandBytes 0) (RandBytes 1) (RandBytes 3)

// Sanity check KEM keygen properties
// ==================================
property check_KEM_KeyGen_pk_length =
    length pk == `publicKeyBytes
    where (pk, _) = KEM_KeyGen

property check_KEM_KeyGen_sk_length =
    length sk == `secretKeyBytes
    where (_, sk) = KEM_KeyGen



//===KEM ENCAPS=============================================================
/**
 * KEM Encapsulation function where the message randomness is provided
 * deterministically. This is necessary for KAT testing and evaluation.
 */
KEM_EncapsDet :
    ByteString (N / 8) ->
    ByteString publicKeyBytes ->
    (ByteString bytesCCADec, ByteString keyBytes)
KEM_EncapsDet m pk = (ciphertext, sessionKey)
  where
    // Hash m to get the actual message (line 2 of Algorithm 21)
    m_hashed     : ByteString (N / 8)
    m_hashed     = SHA3_256::hashBytes m

    // Hash pk to get pk_hash (used in G)
    pk_hash      : ByteString hashBytes
    pk_hash      = SHA3_256::hashBytes pk

    // buf = pk_hash || m_hashed, then hash with SHA3-512 to get (r, K_hat)
    buf          : ByteString (hashBytes + N / 8)
    buf          = pk_hash # m_hashed

    rk           : ByteString 64
    rk           = SHA3_512::hashBytes buf

    // Split rk into r (encapsulation seed) and K_hat (pre-session key)
    r            : ByteString keyBytes
    r            = take`{keyBytes} rk

    k_hat        : ByteString keyBytes
    k_hat        = drop`{keyBytes} rk

    // Encrypt m_hashed using r as the seed
    ciphertext   : ByteString bytesCCADec
    ciphertext   = PKE_EncDet m_hashed r pk

    // Session key = SHA3-256(SHA3-256(ciphertext) || K_hat)
    ct_hash      : ByteString hashBytes
    ct_hash      = SHA3_256::hashBytes ciphertext

    rk2          : ByteString (hashBytes + keyBytes)
    rk2          = ct_hash # k_hat

    sessionKey   : ByteString keyBytes
    sessionKey   = SHA3_256::hashBytes rk2

/**
 * KEM Encaps function where the seeds are NOT provided. Rather, they are
 * "randomly" produced via our lovely RandBytes function (just a bunch of
 * continuous 676767's... lol. It's a funny number reference. Get it?)
 */
KEM_Encaps :
    ByteString publicKeyBytes ->
    (ByteString bytesCCADec, ByteString keyBytes)
KEM_Encaps pk = KEM_EncapsDet (RandBytes 4) pk



//===KEM DECAPS=============================================================
/**
 * Corresponding KEM Decapsulation function.
 */
KEM_Decaps :
    ByteString bytesCCADec ->
    ByteString secretKeyBytes ->
    ByteString keyBytes
KEM_Decaps ciphertext secretKey = sessionKey
  where
    // Extract components from secret key: z || pk_hash || pk || sk_cpa
    z        : ByteString keyBytes
    z        = take`{keyBytes} secretKey

    pk_hash  : ByteString hashBytes
    pk_hash  = take`{hashBytes} (drop`{keyBytes} secretKey)

    pk       : ByteString publicKeyBytes
    pk       = take`{publicKeyBytes} (drop`{keyBytes + hashBytes} secretKey)

    sk_cpa   : ByteString indcpaSecretKeyBytes
    sk_cpa   = drop`{keyBytes + hashBytes + publicKeyBytes} secretKey

    // Decrypt ciphertext to recover m'
    m'       : ByteString (N / 8)
    m'       = PKE_Decrypt ciphertext sk_cpa

    // Re-derive r' and K_hat' using pk_hash and m'
    buf      : ByteString (hashBytes + N / 8)
    buf      = pk_hash # m'

    rk'      : ByteString 64
    rk'      = SHA3_512::hashBytes buf

    r'       : ByteString keyBytes
    r'       = take`{keyBytes} rk'

    k_hat'   : ByteString keyBytes
    k_hat'   = drop`{keyBytes} rk'

    // Re-encrypt to verify
    c'       : ByteString bytesCCADec
    c'       = PKE_EncDet m' r' pk

    // Hash ciphertext
    ct_hash  : ByteString hashBytes
    ct_hash  = SHA3_256::hashBytes ciphertext

    // Constant-time selection: if c' == c use K_hat', else use z
    k_select : ByteString keyBytes
    k_select = if c' == ciphertext then k_hat' else z

    rk_final : ByteString (hashBytes + keyBytes)
    rk_final = ct_hash # k_select

    sessionKey : ByteString keyBytes
    sessionKey = SHA3_256::hashBytes rk_final
