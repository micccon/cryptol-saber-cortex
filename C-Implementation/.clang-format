# I always use LLVM, but we can change if needed
BasedOnStyle: LLVM

# 4 spaces per indent (standard C, but could do 2 or 3 as well)
IndentWidth: 4

# Spaces only, no tabs
UseTab: Never

# K&R / 1TBS brace style — opening brace on same line as control statement
#         e.g. if (condition) {
# (this is personal pref)
BreakBeforeBraces: Attach

# Maximum line width before clang-format wraps — default is 80, but 
# it's nice to have it a little wider for inline comments where necessary
ColumnLimit: 120

# Always insert a newline at the end of the file 
# (helps eliminate compiler warnings from headers w/out trailing newlines)
InsertNewlineAtEOF: true